# ─────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────
PORT=5000

# PostgreSQL connection string (raw pg, no Supabase)
# Format: postgres://user:password@host:port/dbname?uselibpqcompat=true&sslmode=require
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@your.server.ip:5432/babu_billing?uselibpqcompat=true&sslmode=require

# JWT Secret — change this to a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_key

# ─────────────────────────────────────────────
# Client (Vite) Build-time Environment Variables
# ─────────────────────────────────────────────
# These are used during `npm run build` of the React frontend.
# For Docker/Coolify, these become ARGs in the Dockerfile.

VITE_API_URL=/api
VITE_SERVER_URL=

# ─────────────────────────────────────────────
# Default Admin Credentials (after migration)
# ─────────────────────────────────────────────
# Email:    admin@babuadvocate.com
# Password: Admin@12345  (change after first login via DB)
